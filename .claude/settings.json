{
    "permissions": {
        "allow": [
            "Read(*)",
            "Bash(git status)",
            "Bash(git diff)",
            "Bash(git log --oneline)",
            "Bash(dotnet build)",
            "Bash(dotnet test)",
            "Bash(dotnet restore)"
        ],
        "ask": [
            "Bash(git add *)",
            "Bash(git commit *)",
            "Bash(dotnet add *)",
            "Bash(dotnet ef *)",
            "Write(appsettings*.json)"
        ],
        "deny": [
            "Bash(rm *)",
            "Bash(rm -rf *)",
            "Read(.env)",
            "Read(.env.local)",
            "Write(.env)",
            "Write(.env.local)",
            "Read(secrets/**)",
            "Write(secrets/**)",
            "Bash(git push *)"
        ]
    }
}
